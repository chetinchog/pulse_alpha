package repository

import (
	"context"
	"errors"
	"sync"

	"github.com/mgonzalez/pulse_alpha/portfolio-service/internal/domain"
)

var ErrNotFound = errors.New("position not found")
var ErrAlreadyExists = errors.New("position already exists")

// MemoryRepository implements PositionRepository with in-memory storage
type MemoryRepository struct {
	mu        sync.RWMutex
	positions map[string]domain.Position
}

// NewMemoryRepository creates a new in-memory repository
func NewMemoryRepository() *MemoryRepository {
	return &MemoryRepository{
		positions: make(map[string]domain.Position),
	}
}

// Create adds a new position
func (m *MemoryRepository) Create(ctx context.Context, position domain.Position) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	if _, exists := m.positions[position.ID]; exists {
		return ErrAlreadyExists
	}

	m.positions[position.ID] = position
	return nil
}

// GetAll returns all positions
func (m *MemoryRepository) GetAll(ctx context.Context) ([]domain.Position, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	positions := make([]domain.Position, 0, len(m.positions))
	for _, position := range m.positions {
		positions = append(positions, position)
	}

	return positions, nil
}

// GetByID retrieves a position by ID
func (m *MemoryRepository) GetByID(ctx context.Context, id string) (*domain.Position, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	position, exists := m.positions[id]
	if !exists {
		return nil, ErrNotFound
	}

	return &position, nil
}

// Update modifies an existing position
func (m *MemoryRepository) Update(ctx context.Context, position domain.Position) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	if _, exists := m.positions[position.ID]; !exists {
		return ErrNotFound
	}

	m.positions[position.ID] = position
	return nil
}

// Delete removes a position
func (m *MemoryRepository) Delete(ctx context.Context, id string) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	if _, exists := m.positions[id]; !exists {
		return ErrNotFound
	}

	delete(m.positions, id)
	return nil
}
